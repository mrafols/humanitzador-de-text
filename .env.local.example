# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="genera-un-secret-aleatori-o-executa-openssl-rand-base64-32"

# Google OAuth (Opcional - per permetre inici de sessió amb Google)
# Si no es configuren, l'eina permet l'accés directe/convidat
GOOGLE_CLIENT_ID="el-teu-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="el-teu-google-client-secret"

# APIs d'Intel·ligència Artificial Gratuïtes (Configura'n almenys una)
# 1. Google Gemini (Gratis a https://aistudio.google.com/app/apikey)
GOOGLE_GEMINI_API_KEY="la-teva-api-key-de-gemini"

# 2. Groq (Gratis a https://console.groq.com/keys)
GROQ_API_KEY="la-teva-api-key-de-groq"

# 3. OpenRouter (Opcional - https://openrouter.ai/keys)
OPENROUTER_API_KEY=""
